{
  "name": "vscode-nvm",
  "displayName": "vscode nvm integration",
  "description": "Use the node version from .nvmrc in terminals, tasks and the debugger",
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "Allan Barcelos"
  },
  "publisher": "allanbarcelos",
  "repository": {
    "type": "git",
    "url": "https://github.com/allanbarcelos/vscode-nvm.git"
  },
  "bugs": {
    "url": "https://github.com/allanbarcelos/vscode-nvm/issues"
  },
  "keywords": [
    "nvm",
    "nvmrc",
    "node",
    "version"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.nvmrc"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "yarn run compile && yarn run lint",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/mocha": "^10",
    "@types/node": "^20",
    "@types/vscode": "~1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3",
    "eslint": "^9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8"
  }
}
